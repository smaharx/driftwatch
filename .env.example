# Backend Configuration
DATABASE_URL=postgresql://driftwatch_user:driftwatch_password@localhost:5432/driftwatch_db
REDIS_URL=redis://localhost:6379/0

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=DriftWatch API
DEBUG=False

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Alerts & Notifications
SLACK_WEBHOOK_URL=
SLACK_ENABLED=False

# Email Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@driftwatch.local
EMAIL_ENABLED=False

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage
S3_BUCKET_NAME=driftwatch-datasets
S3_REGION=us-east-1
USE_LOCAL_STORAGE=True
LOCAL_STORAGE_PATH=./data/storage

# Feature Flags
ENABLE_STREAMING=False
ENABLE_KAFKA=False
